# WhatsApp Cloud API
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# AWS
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/boost-messages.fifo

# Database
DATABASE_URL=postgresql://boost:boost@localhost:5432/boost

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI (LangChain Sales Agent)
OPENAI_API_KEY=sk-...
USE_AI_AGENT=true
COMPANY_NAME=Boost
PRODUCT_CATEGORY=produtos digitais

# Marca/persona — selecione a configuração white-label
# Opções: default | keune
AGENT_BRAND=default
