# ─── Anthropic API ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Evolution API (WhatsApp via Baileys) ─────────────────────────────────
EVOLUTION_API_URL=https://sua-evolution.api
EVOLUTION_API_KEY=sua-chave
EVOLUTION_INSTANCE=sua-instancia

# ─── CRM ──────────────────────────────────────────────────────────────────
# Provider: hubspot (default) ou pipedrive
CRM_PROVIDER=hubspot

# HubSpot (private app token)
# https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_TOKEN=pat-na1-...

# Pipedrive (caso use ele em vez de HubSpot)
PIPEDRIVE_TOKEN=seu-token-pipedrive
PIPEDRIVE_URL=https://api.pipedrive.com/v1

# ─── Calendly ─────────────────────────────────────────────────────────────
# Personal Access Token: https://calendly.com/integrations/api_webhooks
CALENDLY_TOKEN=seu-token-calendly
# URI completa do event_type que será usado (obter via GET /event_types)
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/ABCD-1234-EFGH
# Link público fallback caso a API falhe
CALENDLY_FALLBACK_URL=https://calendly.com/sua-empresa/20min

# ─── Slack (notificação de handoff) ───────────────────────────────────────
# Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
